# Environment
.env

# Output (generated files)
output/texts/
output/images/
output/configs/
output/videos/
output/approved/
output/uploaded/

# Dedup trackers
data/used_photos.json
output/texts/used_texts.json
output/texts/*_tmp.json

# Format drafts (generated content batches) — used.json and topics.md ARE tracked
formats/*/drafts/

# Per-format yaml config lifecycle (generated render configs, not source content)
formats/*/configs/new/
formats/*/configs/waiting_upload/
formats/*/configs/archive/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# macOS
.DS_Store

# YouTube OAuth credentials (sensitive)
credentials.json
token.json
logs/
.DS_Storemusic/long/*.mp3
